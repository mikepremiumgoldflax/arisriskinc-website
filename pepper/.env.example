# Pepper Botts — configuration. Copy this file to ".env" and fill it in.
# NEVER commit your real .env (it's git-ignored).

# --- Required ---------------------------------------------------------------
# Telegram bot token from @BotFather (the Pepper Botts bot).
PEPPER_BOT_TOKEN=
# Claude API key — https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Strongly recommended ---------------------------------------------------
# Your numeric Telegram chat id. When set, Pepper ONLY talks to you and uses this
# as the destination for the 8 AM scripture and reminder pushes.
# Don't know it? Start the bot, message it, and it replies with your chat id.
PEPPER_OWNER_CHAT_ID=

# --- Research (web search) --------------------------------------------------
# Tavily key — https://tavily.com (free tier). Enables the web_search tool.
TAVILY_API_KEY=

# --- Email (send mail on your behalf) ---------------------------------------
# Gmail address + App Password (https://myaccount.google.com/apppasswords, needs 2FA).
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- Optional tuning --------------------------------------------------------
# IANA timezone for the daily scripture & reminders.
PEPPER_TIMEZONE=America/New_York
# Daily scripture time, 24h HH:MM. Leave blank to disable.
PEPPER_SCRIPTURE_TIME=08:00
# Claude model (set to claude-sonnet-4-6 for faster/cheaper replies).
PEPPER_MODEL=claude-opus-4-8
# Your name, used naturally in conversation.
PEPPER_OWNER_NAME=
PEPPER_OWNER_EMAIL=admin@arisriskinc.com
